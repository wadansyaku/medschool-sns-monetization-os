{
  "name": "05_video_os",
  "version": "1.0.0",
  "description": "Remotion workspace for 理系再建ラボ video production",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.448",
    "@remotion/tailwind-v4": "4.0.448",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.448",
    "tailwindcss": "4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.448",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "validate:packages": "node scripts/validate-packages.mjs",
    "list:packages": "node scripts/week-render.mjs list",
    "still:thumbnail": "remotion still W01BridgeThumbnail out/w01-thumb.png --frame=0",
    "still:long:cover": "remotion still W01BridgeLong out/w01-long-cover.png --frame=45",
    "still:long:scene": "remotion still W01BridgeLong out/w01-long-scene.png --frame=620",
    "still:long:outro": "remotion still W01BridgeLong out/w01-long-outro.png --frame=2170",
    "still:short01": "remotion still W01BridgeShort01 out/w01-short-01.png --frame=60",
    "still:short02": "remotion still W01BridgeShort02 out/w01-short-02.png --frame=60",
    "still:short03": "remotion still W01BridgeShort03 out/w01-short-03.png --frame=60",
    "still:short04": "remotion still W01BridgeShort04 out/w01-short-04.png --frame=60",
    "still:week01": "node scripts/week-render.mjs still week01",
    "still:week02": "node scripts/week-render.mjs still week02",
    "still:week03": "node scripts/week-render.mjs still week03",
    "still:all": "node scripts/week-render.mjs still all",
    "render:short01": "remotion render W01BridgeShort01 out/w01-short-01.mp4",
    "render:short02": "remotion render W01BridgeShort02 out/w01-short-02.mp4",
    "render:short03": "remotion render W01BridgeShort03 out/w01-short-03.mp4",
    "render:short04": "remotion render W01BridgeShort04 out/w01-short-04.mp4",
    "render:long:draft": "remotion render W01BridgeLong out/w01-long-draft.mp4 --scale=0.5",
    "render:week01": "node scripts/week-render.mjs render week01",
    "render:week02": "node scripts/week-render.mjs render week02",
    "render:week03": "node scripts/week-render.mjs render week03"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
